# ─── Backend Secrets ──────────────────────────────────────────
# REQUIRED — change these before running in production!
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/social_dashboard.db

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# ─── Gunicorn / Uvicorn ──────────────────────────────────────
# Number of worker processes (default: 2)
WEB_CONCURRENCY=2
