# ─── Backend Secrets ──────────────────────────────────────────
# REQUIRED — change ALL of these before running in production!
ADMIN_USER=CHANGE_ME_ADMIN_USER
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SECRET_KEY=CHANGE_ME_SECRET_KEY_MIN_32_CHARS

# ─── Database ─────────────────────────────────────────────────
# Default uses SQLite stored in the Docker volume at /app/data/
DATABASE_URL=sqlite:///./data/social_dashboard.db

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# ─── Gunicorn / Uvicorn ──────────────────────────────────────
# Number of worker processes (default: 2)
WEB_CONCURRENCY=2
